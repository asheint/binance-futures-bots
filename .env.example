# Copy this file to .env and fill in your DEMO API keys.

# demo = fake money (demo-fapi.binance.com) | live = REAL money
BINANCE_ENV=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Only needed if you ever switch to live. Keep it empty while practising.
ALLOW_LIVE_TRADING=

# Defaults for each trade
RISK_PCT=1          # % of balance lost if the stop-loss is hit
REWARD_RISK=2       # take-profit = 2x the risk
LEVERAGE=3

# Hard safety limits the bot refuses to go above
MAX_RISK_PCT=2
MAX_LEVERAGE=5

JOURNAL_FILE=trades.csv

# Crazy bot (crazy_bot.py, demo only)
# Its own account: fill these with a SECOND demo/testnet account's keys. Empty = shares the account above.
CRAZY_API_KEY=
CRAZY_API_SECRET=
CRAZY_BASE_URL=              # empty = same as above; testnet: https://testnet.binancefuture.com
CRAZY_LOSS_USDT=2            # loss when the stop-loss is hit, after fees
CRAZY_TARGET_USDT=2          # take-profit = this much net profit, after fees
CRAZY_MIN_CONFIRMATIONS=5    # out of 9
CRAZY_MAX_LEVERAGE=20        # highest leverage; less where the coin allows less
CRAZY_STOP_AT_LIQ=0.8        # stop-loss sits 80% of the way from entry to the liquidation price
CRAZY_MIN_VOLUME_M=30        # only scan coins with 24h volume above this (millions USDT)

# News bot (news_bot.py, demo only): shorts coins right after Binance announces their delisting
NEWS_RISK_USDT=50            # loss when the stop-loss is hit, after fees
NEWS_STOP_PCT=25             # stop-loss this % above the entry
NEWS_HOLD_MIN=240            # close the short this many minutes after entry
NEWS_LEVERAGE=2              # isolated; keeps liquidation well beyond the 25% stop
NEWS_POLL_SECONDS=2          # how often to check Binance's delisting announcements
NEWS_MAX_AGE_MIN=30          # announcements older than this are not traded

# Sniper bot (sniper_bot.py, demo only): trend (4h) + key level + closed trigger candle at the level
SNIPER_RISK_USDT=10          # loss when the stop-loss is hit, after fees
SNIPER_MIN_RR=2              # skip unless the target is at least this many times the risk
SNIPER_MAX_LEVERAGE=10       # lower automatically so liquidation stays well beyond the stop
SNIPER_MIN_VOLUME_M=50       # only coins with 24h volume above this (millions USDT)
SNIPER_MAX_COINS=40          # read the charts of the top N coins by volume
SNIPER_MAX_HOLD_H=48         # close a trade that hasn't hit stop or target after this many hours
SNIPER_ADX_MIN=20            # below this 1h ADX the market is choppy: no lines
SNIPER_MAX_ALT_SAME_SIDE=2   # at most this many altcoin longs (or shorts) open at once: they move together

# Copy bot (copy_bot.py): SHADOW ONLY, places no orders. Ranks Binance lead traders and copies the best on paper
COPY_FOLLOW=8                # traders followed at once
COPY_NOTIONAL=100            # paper position size per copy, USDT
COPY_STOP_PCT=8              # our safety stop: close a copy that moves this % against us
COPY_POLL=60                 # seconds between checks of their open positions
COPY_RESCOUT_H=24            # hours between scouts
COPY_BOARD_PAGES=3           # pages of 30 traders read per board sort (ROI, PnL, Sharpe, copier PnL)
COPY_MIN_DAYS=60             # skip lead portfolios younger than this
COPY_MIN_TRADES=40           # skip traders with fewer closed trades
COPY_MAX_DRAWDOWN=40         # skip a 90-day drawdown above this %
COPY_MAX_LEVERAGE=25         # skip an average leverage above this
COPY_MIN_BALANCE=1000        # skip lead accounts smaller than this (USDT)
COPY_MAX_WIN_RATE=90         # skip win rates at or above this: losers are usually being kept open
